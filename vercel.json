                results["고정비"] += 1
            else:
                results["errors"].append(f"고정비_{item['내역명']}: {r}")
        except Exception as e:
            results["errors"].append(f"고정비_{item['내역명']}_{str(e)}")

    return {
        "statusCode": 200,
        "body": json.dumps({
            "message": f"{current_month} 자동화 완료",
            "수강료청구서": results["수강료청구서"],
